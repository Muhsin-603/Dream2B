{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Dream2B",
            "type": "shell", 
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "${workspaceFolder}/Dream2B.exe",
                "-I${workspaceFolder}/external/raylib/include",
                "-L${workspaceFolder}/external/raylib/lib",
                "-lraylib",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "The correct build task for Drac."
        }
    ]
}